{:verbs
 {;; Skip workflow — just execute the prompt directly
  "do" {:prompt ""
        :workflow :skip}

  ;; Standard workflow — WORKER → TESTER → REVIEWER → CURATOR
  "fix"     {:prompt "Fix the following issue: {target}."
             :params [{:name "target"}]
             :workflow :standard}
  "debug"   {:prompt "Debug the following issue: {target}."
             :params [{:name "target"}]
             :workflow :standard}
  "edit"    {:prompt "Edit {target} to {change}."
             :params [{:name "target"}
                      {:name "change" :default "make the requested changes"}]
             :workflow :standard}
  "build"   {:prompt "Build a new feature:"
             :workflow :standard}
  "update"  {:prompt "Update {target} to {change}."
             :params [{:name "target"}
                      {:name "change"}]
             :workflow :standard}
  "refactor" {:prompt "Can we refactor {target} to {change}?"
              :params [{:name "target"}
                       {:name "change" :default "be simpler or more efficient"}]
              :workflow :standard}

  ;; Architect workflow — ARCHITECT → CURATOR
  "plan"    {:prompt "Create an implementation plan for {target}."
             :params [{:name "target"}]
             :workflow :architect}
  "design"  {:prompt "Design the architecture for {target}."
             :params [{:name "target"}]
             :workflow :architect}

  ;; TDD workflow — TESTER → WORKER → TESTER → REVIEWER → CURATOR
  "test"    {:prompt "Write tests for {target}."
             :params [{:name "target"}]
             :workflow :tdd}
  "tdd"     {:prompt "Implement {target} using test-driven development."
             :params [{:name "target"}]
             :workflow :tdd}
  "fix-test" {:prompt "Fix the following test: {target}."
              :params [{:name "target"}]
              :workflow :standard}

  ;; Review workflow — REVIEWER → DONE
  "review"  {:prompt "Review {target}, focusing on {scope}."
             :params [{:name "target"}
                      {:name "scope"  :default "correctness and code quality"}]
             :workflow :review}
  "check"  {:prompt "Double-check {target}"
            :params [{:name "target"}]
            :workflow :review}

  ;; Explain workflow — EXPLAINER → DONE
  "explain" {:prompt "Explain how {target} works."
             :params [{:name "target"}]
             :workflow :explain}
  "ux-patterns" {:prompt "Does these changes follow our core UX principles?
                          
1. No dependent state updates using `use-effect` 
- This causes confusing updates and is typically used in lieu of memoization 

2. No storing of _data_ in _state_ 
- Centralize state management at the top-level page

3. Components only depend on data to render their own view 
- Don't recompute / re-render the entire page for every change
- Don't pass the entire object to every subcomponent

4. Every component must have TESTS
"
                 :workflow :review}}

 :modifiers
 {"error"       {:prompt "The error message is: {error_message}."
                 :params [{:name "error_message"}]
                 :applies-to :all}
  "thorough"    {:prompt "Be thorough. Compare against the broader codebase."
                 :applies-to :all}
  "min"         {:prompt "Make the smallest change possible."
                 :applies-to :worker}
  "no-hedge"    {:prompt "Be direct and confident. No hedging."
                 :applies-to :reviewer}
  "step-by-step" {:prompt "Explain your reasoning at each step."
                  :applies-to :all}
  "style"       {:prompt "Follow the patterns in {ref}."
                 :params [{:name "ref" :default "the existing codebase"}]
                 :applies-to :worker}
  "pr-description" {:prompt "Update the PR description to follow this template:
```
## Summary

{short summary of the change}
                             
## Changes

- {change 1}
- {change 2}
...

## How was this change tested?

- {testing approach}

## Rollout

{rollout plan, e.g. gradual rollout, monitoring strategy, etc.}
```"
                    :applies-to :all}}}
